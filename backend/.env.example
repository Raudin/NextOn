PORT=8080
DB_PATH=/data/nexton.db
TMDB_API_KEY=dummy
OMDB_API_KEY=
JWT_SECRET=your_jwt_secret_key_here

# Optional second-level cache. Leave unset to run on the in-process caches only,
# which is the default for local development. When running through
# docker-compose this points at the bundled `redis` service.
#
# The backend treats Redis as strictly optional: if it is unset or unreachable
# it logs once at startup and falls back, and a mid-flight outage degrades
# performance rather than failing requests.
# REDIS_URL=redis://redis:6379/0

# Prometheus metrics exposition. Unset means the metrics listener is never
# started, which is the default for local development. The image sets it to
# ":9090" so production has it on without extra configuration.
#
# Bind it inside the container only. It is a separate listener from PORT exactly
# so that routing to the API's public domain cannot reach it, so do not publish
# this port and do not point a domain at it: the scrape comes from Prometheus
# over the project network (see monitoring/prometheus.yml).
# METRICS_ADDR=:9090

# Optional bearer token enforced on the metrics listener. Leave unset for the
# in-network scrape; set it only if the port is ever reachable from outside the
# container network, and mirror the value in the scrape config's authorization
# block.
# METRICS_TOKEN=

# Optional label reported as nexton_build_info{version=...}, so a dashboard can
# be pinned to a specific rollout. Set it as a real environment variable (for
# example in the service's environment in Dokploy) rather than in this file: it
# is read at process start, before .env is loaded. Unset reports "dev".
# APP_VERSION=
